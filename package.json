{
  "name": "design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "check": "node scripts/build-data.mjs --check",
    "import:colors": "node scripts/import-colors.mjs",
    "dev": "npm run build:data && vite",
    "build": "npm run build:data && vue-tsc --noEmit && vite build",
    "test": "node --test \"scripts/*.test.mjs\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.2.6",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@headlessui/vue": "^1.7.23",
    "@nethesis/nethesis-brands-svg-icons": "github:nethesis/Font-Awesome#ns-brands",
    "@nethesis/nethesis-light-svg-icons": "github:nethesis/Font-Awesome#ns-light",
    "@nethesis/nethesis-solid-svg-icons": "github:nethesis/Font-Awesome#ns-solid",
    "@nethesis/vue-components": "^3.14.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.9.0",
    "marked": "^18.0.0",
    "tailwindcss": "^4.1.10",
    "typescript": "~6.0.0",
    "vite": "^8.0.0",
    "vue-tsc": "^3.0.0",
    "yaml": "^2.8.0"
  }
}
