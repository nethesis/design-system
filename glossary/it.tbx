<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE martif PUBLIC "ISO 12200:1999A//DTD MARTIF core (DXFcdV04)//EN" "TBXcdv04.dtd">
<!-- Generated from glossary.yaml by scripts/build-data.mjs: do not edit. -->
<martif type="TBX" xml:lang="en">
<martifHeader>
<fileDesc>
<sourceDesc>
<p>Nethesis Design System glossary</p>
</sourceDesc>
</fileDesc>
</martifHeader>
<text>
<body>
<termEntry id="system-key">
<descrip>The public identifier of a system registered on My Nethesis.</descrip>
<descrip type="Usage note">Example: &quot;NETH-1234-5678-9ABC-DEF0-1234-5678-9ABC-DEF0&quot;.</descrip>
<langSet xml:lang="en">
<tig>
<term>System key</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Chiave di sistema</term>
</tig>
</langSet>
</termEntry>
<termEntry id="system-key--forbidden-chiave-sistema">
<langSet xml:lang="en">
<tig>
<term>System key</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Chiave sistema</term>
</tig>
</langSet>
</termEntry>
<termEntry id="system-key--forbidden-id-sistema">
<langSet xml:lang="en">
<tig>
<term>System key</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>ID sistema</term>
</tig>
</langSet>
</termEntry>
<termEntry id="system-secret">
<descrip>The credential a system uses to connect to My Nethesis. It is shown only once, when it is generated.</descrip>
<descrip type="Usage note">Example: &quot;my_0123456789abcdef0123.0123456789abcdef0123456789abcdef01234567&quot;. In Italian, use &quot;Segreto di sistema&quot; like &quot;Chiave di sistema&quot;; &quot;il segreto del sistema &lt;name&gt;&quot; is fine only for a specific system.</descrip>
<langSet xml:lang="en">
<tig>
<term>System secret</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Segreto di sistema</term>
</tig>
</langSet>
</termEntry>
<termEntry id="system-secret--forbidden-segreto-del-sistema">
<langSet xml:lang="en">
<tig>
<term>System secret</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Segreto del sistema</term>
</tig>
</langSet>
</termEntry>
<termEntry id="system-secret--forbidden-token-di-sistema">
<langSet xml:lang="en">
<tig>
<term>System secret</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Token di sistema</term>
</tig>
</langSet>
</termEntry>
<termEntry id="system-secret--forbidden-token-di-registrazione">
<langSet xml:lang="en">
<tig>
<term>System secret</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Token di registrazione</term>
</tig>
</langSet>
</termEntry>
<termEntry id="system-secret--forbidden-token-di-autenticazione">
<langSet xml:lang="en">
<tig>
<term>System secret</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Token di autenticazione</term>
</tig>
</langSet>
</termEntry>
<termEntry id="subscription">
<descrip>The plan of a registered system, such as Community or Enterprise.</descrip>
<descrip type="Usage note">Do not call the subscription a &quot;registration&quot;. Registering a system, that is connecting it to My Nethesis, is fine: &quot;Register system&quot;.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>Subscription</term>
</tig>
</langSet>
</termEntry>
<termEntry id="subscription--forbidden-abbonamento">
<langSet xml:lang="en">
<tig>
<term>Subscription</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Abbonamento</term>
</tig>
</langSet>
</termEntry>
<termEntry id="subscription--forbidden-sottoscrizione">
<langSet xml:lang="en">
<tig>
<term>Subscription</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Sottoscrizione</term>
</tig>
</langSet>
</termEntry>
<termEntry id="add-on">
<descrip>An optional feature bought on NethShop and granted to a system, such as Threat Shield.</descrip>
<descrip type="Usage note">The Italian plural does not change: &quot;gli add-on&quot;.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>Add-on</term>
</tig>
</langSet>
</termEntry>
<termEntry id="add-on--forbidden-servizio-aggiuntivo">
<langSet xml:lang="en">
<tig>
<term>Add-on</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Servizio aggiuntivo</term>
</tig>
</langSet>
</termEntry>
<termEntry id="nethshop">
<descrip>The Nethesis online shop for Nethesis products and services, such as add-ons, appliances and training.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>NethShop</term>
</tig>
</langSet>
</termEntry>
<termEntry id="company">
<descrip>A distributor, a reseller or a customer in My Nethesis, with its users and systems.</descrip>
<descrip type="Usage note">Use &quot;Company&quot; for the generic case; use &quot;Distributor&quot;, &quot;Reseller&quot; or &quot;Customer&quot; when the level matters.</descrip>
<langSet xml:lang="en">
<tig>
<term>Company</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Azienda</term>
</tig>
</langSet>
</termEntry>
<termEntry id="company--forbidden-organizzazione">
<langSet xml:lang="en">
<tig>
<term>Company</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Organizzazione</term>
</tig>
</langSet>
</termEntry>
<termEntry id="threat-shield">
<descrip>A security service that blocks malicious IP addresses and domains using blocklists.</descrip>
<descrip type="Usage note">Its parts are &quot;Threat Shield IP&quot; and &quot;Threat Shield DNS&quot;.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>Threat Shield</term>
</tig>
</langSet>
</termEntry>
<termEntry id="multiwan">
<descrip>The NethSecurity feature that uses several internet connections together, for load balancing or failover.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>MultiWAN</term>
</tig>
</langSet>
</termEntry>
<termEntry id="flashstart">
<descrip>A third-party cloud filter that blocks unwanted websites through DNS, integrated in NethSecurity.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>FlashStart</term>
</tig>
</langSet>
</termEntry>
<termEntry id="create">
<descrip>Make a new object that did not exist before, such as a user, a group or a firewall rule.</descrip>
<descrip type="Usage note">Name the object: &quot;Create user&quot;. Use &quot;Add&quot; when the object already exists and is only associated with another one.</descrip>
<langSet xml:lang="en">
<tig>
<term>Create</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Crea</term>
</tig>
</langSet>
</termEntry>
<termEntry id="add">
<descrip>Associate an object that already exists, for example add a user to a group.</descrip>
<descrip type="Usage note">Use &quot;Create&quot; when the object does not exist yet and is made from scratch.</descrip>
<langSet xml:lang="en">
<tig>
<term>Add</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Aggiungi</term>
</tig>
</langSet>
</termEntry>
<termEntry id="edit">
<descrip>Change the data of an object.</descrip>
<langSet xml:lang="en">
<tig>
<term>Edit</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Modifica</term>
</tig>
</langSet>
</termEntry>
<termEntry id="delete">
<descrip>Permanently destroy an object, such as a contact, a firewall rule or a user.</descrip>
<descrip type="Usage note">Use &quot;Remove&quot; when the object only leaves a list or an association and still exists, for example a user removed from a group. For applications, use &quot;Uninstall&quot;. When the deletion has consequences beyond the object itself, ask for confirmation first: see Delete confirmation in the guidelines.</descrip>
<langSet xml:lang="en">
<tig>
<term>Delete</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Elimina</term>
</tig>
</langSet>
</termEntry>
<termEntry id="delete--forbidden-cancella">
<langSet xml:lang="en">
<tig>
<term>Delete</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Cancella</term>
</tig>
</langSet>
</termEntry>
<termEntry id="delete--forbidden-rimuovi">
<langSet xml:lang="en">
<tig>
<term>Delete</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Rimuovi</term>
</tig>
</langSet>
</termEntry>
<termEntry id="remove">
<descrip>Take an object out of a list or an association without destroying it, for example remove a user from a group.</descrip>
<descrip type="Usage note">Use &quot;Delete&quot; when the object is destroyed.</descrip>
<langSet xml:lang="en">
<tig>
<term>Remove</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Rimuovi</term>
</tig>
</langSet>
</termEntry>
<termEntry id="remove--forbidden-elimina">
<langSet xml:lang="en">
<tig>
<term>Remove</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Elimina</term>
</tig>
</langSet>
</termEntry>
<termEntry id="uninstall">
<descrip>Remove an application, with its data, from NethServer 8.</descrip>
<descrip type="Usage note">Name the application: &quot;Uninstall mail1&quot;.</descrip>
<langSet xml:lang="en">
<tig>
<term>Uninstall</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Disinstalla</term>
</tig>
</langSet>
</termEntry>
<termEntry id="uninstall--forbidden-elimina">
<langSet xml:lang="en">
<tig>
<term>Uninstall</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Elimina</term>
</tig>
</langSet>
</termEntry>
<termEntry id="uninstall--forbidden-rimuovi">
<langSet xml:lang="en">
<tig>
<term>Uninstall</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Rimuovi</term>
</tig>
</langSet>
</termEntry>
<termEntry id="enable">
<descrip>Turn on a feature or an option.</descrip>
<descrip type="Usage note">The resulting state is &quot;Enabled&quot; (&quot;Abilitato&quot;, not &quot;Attivato&quot;).</descrip>
<langSet xml:lang="en">
<tig>
<term>Enable</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Abilita</term>
</tig>
</langSet>
</termEntry>
<termEntry id="enable--forbidden-attiva">
<langSet xml:lang="en">
<tig>
<term>Enable</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Attiva</term>
</tig>
</langSet>
</termEntry>
<termEntry id="disable">
<descrip>Turn off a feature or an option.</descrip>
<descrip type="Usage note">The resulting state is &quot;Disabled&quot; (&quot;Disabilitato&quot;, not &quot;Disattivato&quot;).</descrip>
<langSet xml:lang="en">
<tig>
<term>Disable</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Disabilita</term>
</tig>
</langSet>
</termEntry>
<termEntry id="disable--forbidden-disattiva">
<langSet xml:lang="en">
<tig>
<term>Disable</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Disattiva</term>
</tig>
</langSet>
</termEntry>
<termEntry id="clear">
<descrip>Empty a search field, a selection or a filter.</descrip>
<descrip type="Usage note">&quot;Clear&quot; empties values; &quot;Reset&quot; brings them back to their defaults. For filters, use &quot;Clear selection&quot; (&quot;Azzera selezione&quot;) only inside a single dropdown filter that has nothing selected by default, and &quot;Reset&quot; in every other case: see the Table filters guidelines. The clear button of a search field is &quot;Clear search&quot; (&quot;Azzera ricerca&quot;).</descrip>
<langSet xml:lang="en">
<tig>
<term>Clear</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Azzera</term>
</tig>
</langSet>
</termEntry>
<termEntry id="clear--forbidden-pulisci">
<langSet xml:lang="en">
<tig>
<term>Clear</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Pulisci</term>
</tig>
</langSet>
</termEntry>
<termEntry id="clear--forbidden-svuota">
<langSet xml:lang="en">
<tig>
<term>Clear</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Svuota</term>
</tig>
</langSet>
</termEntry>
<termEntry id="clear--forbidden-cancella">
<langSet xml:lang="en">
<tig>
<term>Clear</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Cancella</term>
</tig>
</langSet>
</termEntry>
<termEntry id="reset">
<descrip>Bring values back to their defaults, for example the filters of a list.</descrip>
<descrip type="Usage note">&quot;Reset filters&quot; (&quot;Reimposta filtri&quot;), &quot;Reset selection&quot; (&quot;Reimposta selezione&quot;), &quot;Reset password&quot; (&quot;Reimposta password&quot;). In Italian, &quot;Ripristina&quot; is for restoring a backup.</descrip>
<langSet xml:lang="en">
<tig>
<term>Reset</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Reimposta</term>
</tig>
</langSet>
</termEntry>
<termEntry id="reset--forbidden-ripristina">
<langSet xml:lang="en">
<tig>
<term>Reset</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Ripristina</term>
</tig>
</langSet>
</termEntry>
<termEntry id="details">
<descrip>The button that opens the page of an object, in a table row or a card.</descrip>
<descrip type="Usage note">An exception to the verb rule for buttons, for brevity: always with the eye icon, and with the object name for screen readers. &quot;Show details&quot; is for content that opens in place.</descrip>
<langSet xml:lang="en">
<tig>
<term>Details</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Dettagli</term>
</tig>
</langSet>
</termEntry>
<termEntry id="details--forbidden-visualizza">
<langSet xml:lang="en">
<tig>
<term>Details</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Visualizza</term>
</tig>
</langSet>
</termEntry>
<termEntry id="sign-in">
<descrip>Enter a product with your credentials.</descrip>
<descrip type="Usage note">&quot;Login&quot; is fine as a noun or modifier: &quot;Login failed&quot;, &quot;last login&quot;, &quot;root login&quot;. Queue login in NethVoice is a different concept: agents &quot;log in to&quot; and &quot;log out of&quot; a queue.</descrip>
<langSet xml:lang="en">
<tig>
<term>Sign in</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Accedi</term>
</tig>
</langSet>
</termEntry>
<termEntry id="sign-in--forbidden-login">
<langSet xml:lang="en">
<tig>
<term>Sign in</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Login</term>
</tig>
</langSet>
</termEntry>
<termEntry id="sign-in--forbidden-effettua-il-login">
<langSet xml:lang="en">
<tig>
<term>Sign in</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Effettua il login</term>
</tig>
</langSet>
</termEntry>
<termEntry id="sign-out">
<descrip>Leave a product and end your session.</descrip>
<langSet xml:lang="en">
<tig>
<term>Sign out</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Esci</term>
</tig>
</langSet>
</termEntry>
<termEntry id="sign-out--forbidden-disconnetti">
<langSet xml:lang="en">
<tig>
<term>Sign out</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Disconnetti</term>
</tig>
</langSet>
</termEntry>
<termEntry id="sign-out--forbidden-logout">
<langSet xml:lang="en">
<tig>
<term>Sign out</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Logout</term>
</tig>
</langSet>
</termEntry>
<termEntry id="username">
<descrip>The name a user signs in with.</descrip>
<descrip type="Usage note">Translate it also in short labels: &quot;Username and password&quot; is &quot;Nome utente e password&quot;, not &quot;Utente e password&quot;.</descrip>
<langSet xml:lang="en">
<tig>
<term>Username</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Nome utente</term>
</tig>
</langSet>
</termEntry>
<termEntry id="username--forbidden-utente">
<langSet xml:lang="en">
<tig>
<term>Username</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Utente</term>
</tig>
</langSet>
</termEntry>
<termEntry id="username--forbidden-username">
<langSet xml:lang="en">
<tig>
<term>Username</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Username</term>
</tig>
</langSet>
</termEntry>
<termEntry id="alert">
<descrip>A notice raised when a monitored condition needs attention, such as a full disk or too many calls waiting in a queue.</descrip>
<langSet xml:lang="en">
<tig>
<term>Alert</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Allarme</term>
</tig>
</langSet>
</termEntry>
<termEntry id="backup-destination">
<descrip>A storage location where backups are saved.</descrip>
<langSet xml:lang="en">
<tig>
<term>Backup destination</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Destinazione di backup</term>
</tig>
</langSet>
</termEntry>
<termEntry id="backup-destination--forbidden-repository-di-backup">
<langSet xml:lang="en">
<tig>
<term>Backup destination</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Repository di backup</term>
</tig>
</langSet>
</termEntry>
<termEntry id="my-nethesis">
<descrip>The Nethesis administration portal, where systems are registered and managed.</descrip>
<descrip type="Usage note">Write &quot;My Nethesis&quot; in full. &quot;My&quot; is only an informal short form, not used in user interfaces. To refer to it indirectly, &quot;Nethesis administration portal&quot; (&quot;portale di amministrazione Nethesis&quot;) is also correct.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>My Nethesis</term>
</tig>
</langSet>
</termEntry>
<termEntry id="nethserver">
<descrip>The Nethesis open source server for small and medium businesses. From a web interface, it installs and manages applications, such as mail, file sharing and NethVoice, on one or more nodes.</descrip>
<descrip type="Usage note">&quot;NethServer 8&quot;, with the version, is also correct. Do not shorten it to &quot;NS8&quot;.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>NethServer</term>
</tig>
</langSet>
</termEntry>
<termEntry id="nethsecurity">
<descrip>The Nethesis open source firewall for small and medium businesses, based on OpenWrt. Many installations can be managed from NethServer 8 with the NethSecurity controller.</descrip>
<descrip type="Usage note">Each installation is called a &quot;unit&quot;.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>NethSecurity</term>
</tig>
</langSet>
</termEntry>
<termEntry id="unit">
<descrip>A single NethSecurity installation, such as one managed by the NethSecurity controller.</descrip>
<descrip type="Usage note">Call the installation &quot;unit&quot;, also in technical texts: &quot;The unit IP address&quot;, &quot;Reset the unit&quot;. &quot;Firewall&quot; stays correct for the feature, as in &quot;firewall rules&quot;, and for the kind of product, as in &quot;NethSecurity is a firewall&quot;.</descrip>
<langSet xml:lang="en">
<tig>
<term>Unit</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Unità</term>
</tig>
</langSet>
</termEntry>
<termEntry id="unit--forbidden-unita-firewall">
<langSet xml:lang="en">
<tig>
<term>Unit</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Unità firewall</term>
</tig>
</langSet>
</termEntry>
<termEntry id="unit--forbidden-dispositivo">
<langSet xml:lang="en">
<tig>
<term>Unit</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Dispositivo</term>
</tig>
</langSet>
</termEntry>
<termEntry id="unit--forbidden-firewall">
<langSet xml:lang="en">
<tig>
<term>Unit</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Firewall</term>
</tig>
</langSet>
</termEntry>
<termEntry id="nethvoice">
<descrip>The Nethesis business phone system (VoIP PBX), installed as an application on NethServer 8. It includes NethVoice CTI, the web app users make and receive calls with, NethLink, its desktop app, and a mobile app also called NethVoice.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>NethVoice</term>
</tig>
</langSet>
</termEntry>
<termEntry id="nethvoice-cti">
<descrip>The NethVoice web app for users, to make and receive calls and manage contacts, call history and presence.</descrip>
<descrip type="Usage note">Write the full name. Exception: inside NethVoice, &quot;CTI&quot; alone is fine when the context is clear. The mobile app is called &quot;NethVoice&quot;, not &quot;NethCTI&quot;.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>NethVoice CTI</term>
</tig>
</langSet>
</termEntry>
<termEntry id="nethlink">
<descrip>The NethVoice CTI desktop app. It shows call notifications even when the browser is closed and supports click-to-call.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>NethLink</term>
</tig>
</langSet>
</termEntry>
<termEntry id="application">
<descrip>Software installed on NethServer 8 from the Software center, such as Mail, Nextcloud or NethVoice.</descrip>
<descrip type="Usage note">Always prefer &quot;Application&quot; to &quot;Instance&quot;; use &quot;Instance&quot; only when strictly necessary. &quot;App&quot; is fine for mobile and desktop apps, such as NethLink or the NethVoice mobile app.</descrip>
<langSet xml:lang="en">
<tig>
<term>Application</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Applicazione</term>
</tig>
</langSet>
</termEntry>
<termEntry id="application--forbidden-app">
<langSet xml:lang="en">
<tig>
<term>Application</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>App</term>
</tig>
</langSet>
</termEntry>
<termEntry id="instance">
<descrip>A single installed copy of an application, such as mail1. The same application can be installed more than once.</descrip>
<descrip type="Usage note">Use &quot;Instance&quot; only when the context strictly requires one specific copy of an application, and &quot;Application&quot; would be misleading: for example, to choose among several copies of the same application (&quot;Choose a NethVoice instance&quot;). In every other case, use &quot;Application&quot;.</descrip>
<langSet xml:lang="en">
<tig>
<term>Instance</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Istanza</term>
</tig>
</langSet>
</termEntry>
<termEntry id="webtop">
<descrip>The groupware application for mail, calendars, contacts and shared documents, installed on NethServer 8.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>WebTop</term>
</tig>
</langSet>
</termEntry>
<termEntry id="nextcloud">
<descrip>The third-party application for file sharing and collaboration, installed on NethServer 8.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>Nextcloud</term>
</tig>
</langSet>
</termEntry>
</body>
</text>
</martif>
